---
import { Image } from "astro:assets";
import HeaderCV from "../components/HeaderCV.astro";
import Footer from "../components/Footer.astro";
import Layout from "./Layout.astro";
import type { CvData } from "../data/types";

interface Props {
  data: CvData;
  noindex?: boolean;
}

const { data, noindex = false } = Astro.props;
---

<Layout title={data.title} noindex={noindex}>
  <HeaderCV />

  <main>
    <div
      class="bg-gray-950 text-gray-50 rounded-lg shadow-md p-8 max-w-3xl mx-auto mt-2 mb-2"
    >
      <!-- HEADER (NO TOCAR) -->
      <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
        <div class="flex-shrink-0">
          <Image
            src="/Yo.jpg"
            width="120"
            height="120"
            alt="Profile"
            class="rounded-full border-4 border-gray-800"
            style="object-fit:cover"
            loading="eager"
          />
        </div>
        <div class="flex-1 space-y-2">
          <h1 class="text-3xl font-bold">Máximo Valfré</h1>
          {data.role && <p class="text-gray-400">{data.role}</p>}
          <div class="flex items-center flex-wrap gap-4">
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5 text-gray-400"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span class="text-sm">{data.contact.email}</span>
            </div>
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5 text-gray-400"
              >
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path>
              </svg>
              <span class="text-sm">{data.contact.phone}</span>
            </div>
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5 text-gray-400"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span class="text-sm">{data.contact.location}</span>
            </div>
          </div>
          <div class="flex justify-center gap-4 mt-4 text-sm">
            <span>{data.contact.linkedin}</span>
            <span>{data.contact.github}</span>
            {data.contact.website && <span>{data.contact.website}</span>}
          </div>
        </div>
      </div>

      <!-- PERFIL -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Perfil</h2>
        {data.profile.map((paragraph, index) => (
          <p class={index === 0 ? "mt-4 text-gray-400" : "mt-3 text-gray-400"} set:html={paragraph}></p>
        ))}
      </section>

      <!-- EXPERIENCIA -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Experiencia</h2>

        <div class="mt-4 space-y-6">
          {data.experience.map((experience, index) => (
            <div>
              <h3 class="text-xl font-semibold">{experience.role}</h3>
              <p class="text-gray-400">
                {experience.org} · {experience.period}
              </p>

              {experience.intro && <p class="mt-3 text-gray-400" set:html={experience.intro}></p>}

              <ul class={index === 0 ? "list-disc pl-6 mt-3 space-y-3 text-gray-400" : "list-disc pl-6 mt-3 space-y-2 text-gray-400"}>
                {experience.bullets.map((bullet) => <li set:html={bullet}></li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- HABILIDADES -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Habilidades Técnicas</h2>

        <div class="grid grid-cols-2 gap-4 mt-4">
          {data.skills.map((skill) => (
            <div class="bg-gray-800 p-4 rounded-md">
              <h3 class="font-semibold">{skill.heading}</h3>
              <p class="mt-2 text-gray-400">{skill.items}</p>
            </div>
          ))}
        </div>

        {data.skillsNote && <p class="mt-4 text-gray-400" set:html={data.skillsNote}></p>}
      </section>

      {data.comoTrabajo && (
        <section class="mt-8">
          <h2 class="text-2xl font-bold">Cómo trabajo</h2>

          <ul class="list-disc pl-6 mt-4 space-y-3 text-gray-400">
            {data.comoTrabajo.map((principle) => (
              <li><strong>{principle.title}</strong> {principle.description}</li>
            ))}
          </ul>
        </section>
      )}

      <!-- EDUCACIÓN -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Educación</h2>

        <div class="mt-4 space-y-3 text-gray-400">
          {data.education.map((item) => <p set:html={item}></p>)}
        </div>
      </section>

      {data.idiomas && (
        <section class="mt-8">
          <h2 class="text-2xl font-bold">Idiomas</h2>
          <p class="mt-4 text-gray-400">{data.idiomas}</p>
        </section>
      )}
    </div>
  </main>

  <Footer />
</Layout>
