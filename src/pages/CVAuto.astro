---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import HeaderCV from "../components/HeaderCV.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Máximo Valfré | Automation & Integrations Developer">
  <HeaderCV />

  <main>
    <div
      class="bg-gray-950 text-gray-50 rounded-lg shadow-md p-8 max-w-3xl mx-auto mt-2 mb-2"
    >
      <!-- HEADER (NO TOCAR) -->
      <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
        <div class="flex-shrink-0">
          <Image
            src="/Yo.jpg"
            width="120"
            height="120"
            alt="Profile"
            class="rounded-full border-4 border-gray-800"
            style="object-fit:cover"
            loading="eager"
          />
        </div>
        <div class="flex-1 space-y-2">
          <h1 class="text-3xl font-bold">Máximo Valfré</h1>
          <div class="flex items-center flex-wrap gap-4">
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5 text-gray-400"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span class="text-sm">maximovalfre170@gmail.com</span>
            </div>
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5 text-gray-400"
              >
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                >
                </path>
              </svg>
              <span class="text-sm">+54 (3385) 433320</span>
            </div>
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5 text-gray-400"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span class="text-sm">Argentina</span>
            </div>
          </div>
          <div class="flex justify-center gap-4 mt-4 text-sm">
            <span>linkedin.com/in/maxivalfre</span>
            <span>github.com/MaxiValfre</span>
          </div>
        </div>
      </div>

      <!-- PERFIL -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Perfil</h2>
        <p class="mt-4 text-gray-400">
          Automation & Integrations Developer con experiencia en el diseño e
          implementación de flujos automáticos para procesos de negocio.
          Especializado en la integración de sistemas mediante APIs, webhooks y
          herramientas no-code, combinando lógica técnica con soluciones
          orientadas a eficiencia operativa, reducción de tareas manuales y
          comunicación automatizada.
        </p>
      </section>

      <!-- AUTOMATIZACIONES -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Experiencia en Automatización</h2>

        <ul class="list-disc pl-6 mt-4 space-y-3 text-gray-400">
          <li>
            Implementación de flujos de automatización con <strong>Make</strong> para
            mensajería automática de bienvenida a nuevos inscriptos vía
            <strong>WhatsApp Business API</strong>.
          </li>
          <li>
            Diseño de un sistema de <strong>notificaciones por eventos</strong>
            (cancelación de clases, avisos urgentes), evitando la comunicación manual
            individual.
          </li>
          <li>
            Integración de plantillas dinámicas en formato JSON según los
            requerimientos de Meta.
          </li>
          <li>
            Obtención y procesamiento de datos desde bases SQL y APIs para envío
            de mensajes personalizados (nombre, teléfono, email).
          </li>
          <li>
            Implementación y manejo de <strong>webhooks</strong> para eventos de mensajería
            y pagos.
          </li>
        </ul>
      </section>

      <!-- EXPERIENCIA COMO DEV (RESUMIDA) -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Experiencia como Desarrollador</h2>

        <ul class="list-disc pl-6 mt-4 space-y-2 text-gray-400">
          <li>
            Desarrollo de aplicaciones web full stack con Next.js, Node.js y SQL
            Server.
          </li>
          <li>
            Implementación de arquitecturas serverless utilizando AWS Lambda,
            API Gateway y S3.
          </li>
          <li>Integración de pagos con Mercado Pago mediante webhooks.</li>
          <li>
            Desarrollo de aplicaciones web y mobile utilizando Firebase y
            Capacitor.
          </li>
        </ul>
      </section>

      <!-- HABILIDADES -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Habilidades Técnicas</h2>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mt-4">
          <div class="bg-gray-800 p-4 rounded-md">
            <h3 class="font-semibold">Automatización</h3>
            <p class="mt-2 text-gray-400">
              Make, Webhooks, Flujos por eventos, Plantillas dinámicas
            </p>
          </div>

          <div class="bg-gray-800 p-4 rounded-md">
            <h3 class="font-semibold">Integraciones</h3>
            <p class="mt-2 text-gray-400">
              WhatsApp Business API, Mercado Pago, APIs REST, JSON
            </p>
          </div>

          <div class="bg-gray-800 p-4 rounded-md">
            <h3 class="font-semibold">Soporte Técnico</h3>
            <p class="mt-2 text-gray-400">
              Node.js, Firebase Functions, SQL Server, Git
            </p>
          </div>
        </div>
      </section>

      <!-- EDUCACIÓN -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Educación</h2>

        <div class="mt-4 space-y-3 text-gray-400">
          <p><strong>Técnico en Electrónica</strong> · ENET, Laboulaye</p>
          <p><strong>Formación Full Stack</strong> · Santex (XAcademy)</p>
          <p><strong>Simulación Laboral</strong> · NoCountry</p>
          <p><strong>Inglés Técnico B2</strong> · CESSI</p>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
