---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import HeaderCV from "../components/HeaderCV.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Máximo Valfré | Full Stack Developer">
  <HeaderCV />

  <main>
    <div
      class="bg-gray-950 text-gray-50 rounded-lg shadow-md p-8 max-w-3xl mx-auto mt-2 mb-2"
    >
      <!-- HEADER (NO TOCAR) -->
      <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
        <div class="flex-shrink-0">
          <Image
            src="/Yo.jpg"
            width="120"
            height="120"
            alt="Profile"
            class="rounded-full border-4 border-gray-800"
            style="object-fit:cover"
            loading="eager"
          />
        </div>
        <div class="flex-1 space-y-2">
          <h1 class="text-3xl font-bold">Máximo Valfré</h1>
          <div class="flex items-center flex-wrap gap-4">
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5 text-gray-400"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span class="text-sm">maximovalfre170@gmail.com</span>
            </div>
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5 text-gray-400"
              >
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path>
              </svg>
              <span class="text-sm">+54 (3385) 433320</span>
            </div>
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5 text-gray-400"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span class="text-sm">Argentina</span>
            </div>
          </div>
          <div class="flex justify-center gap-4 mt-4 text-sm">
            <span>linkedin.com/in/maxivalfre</span>
            <span>github.com/MaxiValfre</span>
          </div>
        </div>
      </div>

      <!-- PERFIL -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Perfil</h2>
        <p class="mt-4 text-gray-400">
          Desarrollador Full Stack con experiencia real en sistemas en producción,
          automatización de procesos e integración de inteligencia artificial.
          Trabajo en el desarrollo de aplicaciones web, microservicios, pipelines
          de datos y agentes inteligentes, combinando Node.js, Python y servicios
          cloud. Utilizo herramientas de IA (Claude, Copilot) como parte de mi
          flujo de trabajo diario para desarrollo asistido y planificación
          estructurada.
        </p>
      </section>

      <!-- EXPERIENCIA -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Experiencia</h2>

        <div class="mt-4 space-y-6">
          <div>
            <h3 class="text-xl font-semibold">Full Stack Developer</h3>
            <p class="text-gray-400">
              Fundación Educativa Saberes · 2024 – Actualidad
            </p>

            <h4 class="text-lg font-semibold mt-4">Plataforma Web</h4>
            <ul class="list-disc pl-6 mt-2 space-y-2 text-gray-400">
              <li>
                Sistema de gestión de pagos para estudiantes con esquemas de cuotas,
                carga de comprobantes y seguimiento, más backoffice administrativo
                de conciliación bancaria.
              </li>
              <li>
                Sistema de gestión de gastos con imputación multinivel (empresa,
                organización, comisión, persona).
              </li>
              <li>
                Frontend con <strong>Next.js, Tailwind CSS y shadcn/ui</strong>.
                Backend serverless con <strong>AWS Lambda, API Gateway y S3</strong>.
                API REST con <strong>Node.js, Express y Sequelize</strong>.
                Base de datos <strong>SQL Server</strong>.
              </li>
            </ul>

            <h4 class="text-lg font-semibold mt-4">Microservicios y Automatización</h4>
            <ul class="list-disc pl-6 mt-2 space-y-2 text-gray-400">
              <li>
                Monorepo de microservicios <strong>Node.js</strong> corriendo como
                Windows Services en VPS con deploy automatizado (PowerShell).
              </li>
              <li>
                Servicio de verificación OCR de comprobantes bancarios con
                <strong>OpenAI GPT</strong>: extracción y validación de montos,
                fechas y DNI/CUIT contra la base de datos, con auto-corrección y
                reglas de confianza.
              </li>
              <li>
                Servicio de envío masivo de emails con rate limiting por perfil
                SMTP, reprogramación automática por cuota y umbral diario por
                campaña.
              </li>
              <li>
                Sincronización <strong>SQL Server → Google Sheets</strong>
                multi-pestaña con escritura chunked, retry/backoff y protección
                de columnas con ARRAYFORMULA.
              </li>
            </ul>

            <h4 class="text-lg font-semibold mt-4">Agente de Conciliación Inteligente (Python)</h4>
            <ul class="list-disc pl-6 mt-2 space-y-2 text-gray-400">
              <li>
                Pipeline de conciliación de pagos que compara <strong>SQL Server</strong>
                contra <strong>Google Sheets</strong>, con motor de allocación,
                scoring graduado y escalación a LLM (<strong>GPT-4o</strong>) para
                casos ambiguos.
              </li>
              <li>
                Arquitectura de 5 capas: Connectors → Rules → Comparator → Agent
                → Writer, con modelos <strong>Pydantic v2</strong>, caché de
                decisiones y patches idempotentes.
              </li>
              <li>
                +125 tests unitarios con <strong>pytest</strong>. CLI con
                <strong>Click</strong>. Base de auditoría en <strong>SQLite</strong>.
              </li>
            </ul>

            <h4 class="text-lg font-semibold mt-4">Automatización de Procesos</h4>
            <ul class="list-disc pl-6 mt-2 space-y-2 text-gray-400">
              <li>
                Flujos con <strong>Make</strong> para mensajería automática vía
                <strong>WhatsApp Business API</strong> (bienvenida, notificaciones
                por eventos, plantillas dinámicas JSON).
              </li>
              <li>
                Webhooks para eventos de mensajería y pagos. Procesamiento de
                datos desde SQL y APIs para mensajes personalizados.
              </li>
            </ul>
          </div>

          <div>
            <h3 class="text-xl font-semibold">Freelance Developer</h3>
            <p class="text-gray-400">Aplicación de citas</p>

            <ul class="list-disc pl-6 mt-3 space-y-2 text-gray-400">
              <li>
                Aplicación web con <strong>HTML, CSS y JavaScript</strong>.
                Backend con <strong>Firebase</strong> (Authentication, Firestore,
                Realtime Database, Storage).
              </li>
              <li>
                Sistema de likes, presencia en tiempo real y gestión de perfiles.
              </li>
              <li>
                Integración de pagos con <strong>Mercado Pago</strong> mediante
                webhooks.
              </li>
              <li>
                Migración a <strong>Capacitor</strong> y publicación en
                <strong>Play Store</strong>.
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- HABILIDADES -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Habilidades Técnicas</h2>

        <div class="grid grid-cols-2 gap-4 mt-4">
          <div class="bg-gray-800 p-4 rounded-md">
            <h3 class="font-semibold">Frontend</h3>
            <p class="mt-2 text-gray-400">
              React, Next.js, Astro, Angular, HTML, CSS, JavaScript, TypeScript
            </p>
          </div>

          <div class="bg-gray-800 p-4 rounded-md">
            <h3 class="font-semibold">Backend & Cloud</h3>
            <p class="mt-2 text-gray-400">
              Node.js, Express, Python, AWS Lambda, API Gateway, S3, Firebase
            </p>
          </div>

          <div class="bg-gray-800 p-4 rounded-md">
            <h3 class="font-semibold">AI & Automation</h3>
            <p class="mt-2 text-gray-400">
              OpenAI API (GPT-4o, Vision), Claude, Copilot, Make, WhatsApp Business API
            </p>
          </div>

          <div class="bg-gray-800 p-4 rounded-md">
            <h3 class="font-semibold">Data & DevOps</h3>
            <p class="mt-2 text-gray-400">
              SQL Server, SQLite, Sequelize, Pydantic, Google Sheets API, Docker, CI/CD, Git
            </p>
          </div>
        </div>
      </section>

      <!-- EDUCACIÓN -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Educación</h2>

        <div class="mt-4 space-y-3 text-gray-400">
          <p><strong>Tecnicatura en Desarrollo Web</strong> · Instituto Superior de Calamuchita (en curso)</p>
          <p><strong>Técnico en Electrónica</strong> · ENET, Laboulaye</p>
          <p><strong>Simulación Laboral</strong> · NoCountry</p>
          <p><strong>Inglés Técnico B2</strong> · CESSI</p>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
