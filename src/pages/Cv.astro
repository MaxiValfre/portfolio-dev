---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import HeaderCV from "../components/HeaderCV.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Máximo Valfré | Full Stack Developer">
  <HeaderCV />

  <main>
    <div
      class="bg-gray-950 text-gray-50 rounded-lg shadow-md p-8 max-w-3xl mx-auto mt-2 mb-2"
    >
      <!-- HEADER (NO TOCAR) -->
      <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
        <div class="flex-shrink-0">
          <Image
            src="/Yo.jpg"
            width="120"
            height="120"
            alt="Profile"
            class="rounded-full border-4 border-gray-800"
            style="object-fit:cover"
            loading="eager"
          />
        </div>
        <div class="flex-1 space-y-2">
          <h1 class="text-3xl font-bold">Máximo Valfré</h1>
          <div class="flex items-center flex-wrap gap-4">
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5 text-gray-400"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span class="text-sm">maximovalfre170@gmail.com</span>
            </div>
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5 text-gray-400"
              >
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path>
              </svg>
              <span class="text-sm">+54 (3385) 433320</span>
            </div>
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5 text-gray-400"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span class="text-sm">Argentina</span>
            </div>
          </div>
          <div class="flex justify-center gap-4 mt-4 text-sm">
            <span>linkedin.com/in/maxivalfre</span>
            <span>github.com/MaxiValfre</span>
          </div>
        </div>
      </div>

      <!-- PERFIL -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Perfil</h2>
        <p class="mt-4 text-gray-400">
          Desarrollador Full Stack con 3 años de experiencia construyendo y
          manteniendo sistemas en producción. Trabajo end-to-end: frontend con
          Next.js y React, backend en Node.js y Python, y despliegue sobre AWS.
          Buena parte de lo que hago es tomar procesos manuales del negocio y
          convertirlos en sistemas confiables, integrando modelos de lenguaje
          donde aportan valor concreto.
        </p>
      </section>

      <!-- EXPERIENCIA -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Experiencia</h2>

        <div class="mt-4 space-y-6">
          <div>
            <h3 class="text-xl font-semibold">Full Stack Developer</h3>
            <p class="text-gray-400">
              Fundación Educativa Saberes · 2024 – Actualidad
            </p>

            <p class="mt-3 text-gray-400">
              Responsable del desarrollo y mantenimiento de la plataforma interna
              y sus servicios de soporte.
            </p>

            <ul class="list-disc pl-6 mt-3 space-y-3 text-gray-400">
              <li>
                <strong>Plataforma de pagos y gastos.</strong> Sistema de cuotas
                para estudiantes con carga de comprobantes y backoffice de
                conciliación bancaria, más un módulo de gastos con imputación
                multinivel. Frontend en <strong>Next.js + Tailwind</strong>, API
                REST con <strong>Node.js, Express y Sequelize</strong> sobre
                <strong>SQL Server</strong>, y funciones serverless en
                <strong>AWS Lambda, API Gateway y S3</strong>.
              </li>
              <li>
                <strong>Automatización de la conciliación de pagos.</strong>
                Reemplacé un cruce manual entre la base de datos y las planillas
                del área administrativa por un pipeline en <strong>Python</strong>
                que resuelve automáticamente los casos claros y escala a revisión
                humana solo los ambiguos, apoyándose en <strong>GPT-4o</strong>.
                Diseñado en capas separadas para poder cambiar el modelo o la
                fuente de datos sin tocar el resto.
              </li>
              <li>
                <strong>Microservicios de soporte.</strong> Monorepo en
                <strong>Node.js</strong> con deploy automatizado: verificación OCR
                de comprobantes bancarios con <strong>OpenAI</strong> que valida
                montos, fechas y datos fiscales contra la base; envío masivo de
                emails con control de cuota; y sincronización periódica de
                <strong>SQL Server → Google Sheets</strong>.
              </li>
              <li>
                <strong>Mensajería automática.</strong> Flujos de
                <strong>WhatsApp Business API</strong> para onboarding y
                notificaciones por evento, conectados por webhooks a los eventos
                de la plataforma.
              </li>
            </ul>
          </div>

          <div>
            <h3 class="text-xl font-semibold">Freelance Developer</h3>
            <p class="text-gray-400">Aplicación de citas · 2023</p>

            <ul class="list-disc pl-6 mt-3 space-y-2 text-gray-400">
              <li>
                Aplicación web con <strong>Firebase</strong> (Authentication,
                Firestore, Realtime Database, Storage): gestión de perfiles,
                sistema de likes y presencia en tiempo real.
              </li>
              <li>
                Integración de pagos con <strong>Mercado Pago</strong> mediante
                webhooks.
              </li>
              <li>
                Empaquetado con <strong>Capacitor</strong> y publicación en
                <strong>Play Store</strong>.
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- PROYECTOS -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Proyectos</h2>

        <ul class="list-disc pl-6 mt-4 space-y-2 text-gray-400">
          <li>
            <strong>Job Hunter</strong> — Pipeline de búsqueda laboral que agrega
            ofertas de múltiples fuentes, las normaliza y las puntúa contra un
            perfil de candidato.
            <em>Python, FastAPI, SQLAlchemy, Playwright, OpenAI, Next.js.</em>
          </li>
          <li>
            <strong>Portfolio personal</strong> — maxivalfre.github.io.
            <em>Astro, Tailwind CSS.</em>
          </li>
        </ul>
      </section>

      <!-- HABILIDADES -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Habilidades Técnicas</h2>

        <div class="grid grid-cols-2 gap-4 mt-4">
          <div class="bg-gray-800 p-4 rounded-md">
            <h3 class="font-semibold">Frontend</h3>
            <p class="mt-2 text-gray-400">
              React, Next.js, Astro, Angular, TypeScript, JavaScript, Tailwind CSS, HTML/CSS
            </p>
          </div>

          <div class="bg-gray-800 p-4 rounded-md">
            <h3 class="font-semibold">Backend</h3>
            <p class="mt-2 text-gray-400">
              Node.js, Express, Python, FastAPI, APIs REST
            </p>
          </div>

          <div class="bg-gray-800 p-4 rounded-md">
            <h3 class="font-semibold">Cloud & Datos</h3>
            <p class="mt-2 text-gray-400">
              AWS (Lambda, API Gateway, S3), SQL Server, SQLite, Sequelize, Firebase
            </p>
          </div>

          <div class="bg-gray-800 p-4 rounded-md">
            <h3 class="font-semibold">IA & Herramientas</h3>
            <p class="mt-2 text-gray-400">
              OpenAI API, Claude, Docker, Git, CI/CD, testing automatizado (pytest)
            </p>
          </div>
        </div>

        <p class="mt-4 text-gray-400">
          Uso asistentes de IA como parte del flujo diario de desarrollo, con
          metodologías de planificación estructurada para cambios grandes.
        </p>
      </section>

      <!-- EDUCACIÓN -->
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Educación</h2>

        <div class="mt-4 space-y-3 text-gray-400">
          <p><strong>Tecnicatura en Desarrollo Web</strong> · Instituto Superior de Calamuchita (en curso)</p>
          <p><strong>Técnico en Electrónica</strong> · ENET, Laboulaye</p>
          <p><strong>Simulación Laboral</strong> · NoCountry</p>
          <p><strong>Inglés Técnico B2</strong> · CESSI</p>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
